<Window x:Class="WarThunderLauncherV2.Windows.SplashOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="800"
        Height="450"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Border x:Name="RootBorder"
            CornerRadius="24"
            Background="#050608"
            BorderBrush="#334C6A"
            BorderThickness="1"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="45"
                              ShadowDepth="0"
                              Opacity="0.65"
                              Color="#000000"/>
        </Border.Effect>

        <Grid>

            <Image x:Name="SplashImage"
                   Stretch="UniformToFill"
                   Visibility="Collapsed"/>

            <Grid x:Name="FallbackLayer">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#080B10" Offset="0"/>
                            <GradientStop Color="#101923" Offset="0.45"/>
                            <GradientStop Color="#050607" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Ellipse Width="520"
                         Height="320"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Margin="0,0,-170,0"
                         Fill="#1857D8FF"
                         Opacity="0.24">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>

                <Ellipse Width="360"
                         Height="360"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-120,0,0,-160"
                         Fill="#55230012"
                         Opacity="0.8">
                    <Ellipse.Effect>
                        <BlurEffect Radius="70"/>
                    </Ellipse.Effect>
                </Ellipse>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="WAR THUNDER"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="#F4FAFF"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="CUSTOM LAUNCHER V2"
                               Margin="0,4,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#7F9CB7"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="Launching..."
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,28,22"
                           FontSize="13"
                           Foreground="#6F879E"/>
            </Grid>

            <Rectangle VerticalAlignment="Top"
                       Height="1"
                       Opacity="0.45">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

        </Grid>
    </Border>
</Window>